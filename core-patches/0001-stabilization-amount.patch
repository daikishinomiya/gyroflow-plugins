+                if amount >= 1.0 { continue; }
+                if let Some(raw) = self.quaternions.get(ts) {
+                    *sq = if amount <= 0.0 { *raw } else { raw.try_slerp(sq, amount, 1e-9).unwrap_or(if amount < 0.5 { *raw } else { *sq }) };
+                }
+            }
+        }
+
         let max_angles = crate::Smoothing::get_max_angles(&self.quaternions, &smoothed_quaternions, compute_params);
 
